# Токен бота от @BotFather
BOT_TOKEN=123456789:AAE...ваш_токен

# Telegram ID главных администраторов через запятую (узнать свой ID: @userinfobot).
# Их нельзя удалить командой /deladmin; остальных админов добавляйте в боте через /addadmin.
ADMIN_IDS=123456789

# Необязательно: путь к базе (по умолчанию data/bot.db)
# DB_PATH=data/bot.db

# Необязательно: каналы обязательной подписки (только недостающие добавляются при старте,
# и проверка подписки включается). Формат: chat_id:@username или chat_id:https://t.me/...
# Несколько записей через запятую.
# REQUIRED_CHANNELS=-1003834817665:@musordrop14886752

# PORT задаёт платформа вроде Render. Локально не указывайте — HTTP-сервер не поднимется.
# PORT=10000
